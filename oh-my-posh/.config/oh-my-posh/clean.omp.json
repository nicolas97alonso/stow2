{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "#7e9cd8",
          "properties": {
            "style": "folder"
          },
          "template": "{{ .Path }}"
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#d27e99",
          "properties": {
            "branch_icon": " ",
            "commit_icon": "",
            "fetch_status": true
          },
          "template": " {{ .HEAD }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .Ahead 0 }} ⇡{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} ⇣{{ .Behind }}{{ end }}"
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#727169",
          "properties": {
            "threshold": 1000,
            "style": "round"
          },
          "template": " {{ .FormattedMs }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "#98bb6c",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#c34043{{ end }}"
          ],
          "properties": {
            "always_enabled": true
          },
          "template": "> "
        }
      ]
    }
  ],
  "final_space": true,
  "version": 2
}
