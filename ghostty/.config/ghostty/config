# Ghostty mirror of ~/stow/wezterm/.config/wezterm/wezterm.lua
# Kept intentionally explicit so the two configs stay diffable side by side.

# 1. "Everforest dark, navy" palette
# The accents are everforest's dark base palette verbatim (sainnhe/everforest).
# The background and the greys are shifted onto a near-black navy instead of
# everforest's warm forest grey (#272e33), so the palette is written out rather
# than using `theme = everforest_dark_hard`. Mirrored in wezterm.lua and in
# nvim's lua/config/palette.lua -- change all three together.
background = 060d16
foreground = d3c6aa

cursor-color = d3c6aa
cursor-text = 060d16
# wezterm's cursor_border has no equivalent (no separate cursor outline color).

selection-background = 24313f
selection-foreground = d3c6aa

palette = 0=#1a2430
palette = 1=#e67e80
palette = 2=#a7c080
palette = 3=#dbbc7f
palette = 4=#7fbbb3
palette = 5=#d699b6
palette = 6=#83c092
palette = 7=#d3c6aa
# everforest defines no separate bright set, so 9-15 are the accents blended
# 15% toward white. btop/htop lean on brights being distinguishable.
palette = 8=#7d8b8b
palette = 9=#ea9193
palette = 10=#b4c993
palette = 11=#e0c692
palette = 12=#92c5be
palette = 13=#dca8c1
palette = 14=#96c9a2
palette = 15=#dacfb7

# 2. Font
# wezterm matches on full name ("GoogleSansCode NFM"), Ghostty on family name.
font-family = GoogleSansCode Nerd Font Mono
font-family = Menlo
font-size = 13
# wezterm's "Symbols Nerd Font Mono" fallback is a font wezterm ships built-in;
# it isn't a system font. Not needed here: the Nerd Font carries the icon
# glyphs, and Ghostty draws powerline/box-drawing from internal sprites, which
# also makes wezterm's allow_square_glyphs_to_overflow_width unnecessary.

# Approximates wezterm's line_height = 1.07. Not a computed equivalent -- the
# two renderers derive natural line height differently, so tune by eye.
# Note the block cursor does NOT scale with this (see adjust-cursor-height).
adjust-cell-height = 7%

# wezterm's freetype_load_target has no equivalent: Ghostty uses CoreText on
# macOS, so there is no FreeType hinting knob. If text shows dark fringing
# against the transparent background, `alpha-blending = linear-corrected` is
# the knob to try -- it is weight-neutral, not a "lighter text" setting.

# 3. Transparency + blur
# Changing background-opacity on macOS needs a full quit to take effect, and
# it is disabled in native fullscreen.
background-opacity = 0.9
# wezterm calls its value a pixel radius, Ghostty an intensity (0-255).
# Same number, not verified to be the same scale -- compare by eye.
background-blur = 30

# 4. No titlebar, matching wezterm's window_decorations = "RESIZE".
# Keeps the native frame, rounded corners, resize and native fullscreen.
# Trade-off: this sets tabbingMode = .disallowed at the AppKit level, so
# native tabs do not work at all -- cmd+t opens a new window instead, and
# macOS has no tab-overview fallback (window-show-tab-bar is GTK-only).
# To get real tabs back, swap this line for:
#   macos-titlebar-style = tabs
#   macos-window-buttons = hidden
# and expect a permanent title strip at the top even with one tab.
# Also note: the top area can no longer drag the window; drag the frame
# edges, or enable ctrl+cmd+drag globally with
#   defaults write -g NSWindowShouldDragOnGesture -bool true
macos-titlebar-style = tabs
macos-window-buttons = hidden

# 5. Window padding.
# Ghostty's unit is points, wezterm's is pixels, so wezterm's 20 lands at
# roughly 10 here on a 2x display.
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true

# wezterm's tab bar styling and hide_tab_bar_if_only_one_tab have no
# equivalent: macOS tabs are native chrome, and they are disabled outright
# by the hidden titlebar above.

# 6. Steady block cursor.
# shell-integration's `cursor` feature is on by default and forces a bar at
# the zsh prompt, which would override this; no-cursor keeps the block. It
# also avoids the integration leaking a block cursor into fzf widgets.
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor,ssh-env

# 7. wezterm parity for defaults that differ
# Ghostty resolves macos-option-as-alt to false on non-US layouts (this
# machine is Spanish - ISO), which breaks alt+b/alt+f in zsh and <M-...> in
# nvim. `left` matches wezterm's default: left Option = Alt, right Option
# still composes, so @ # [ ] { } remain typeable.
macos-option-as-alt = left

# Plain `true` copies to a private Ghostty-only pasteboard on macOS, so
# selections never reach the system clipboard. `clipboard` writes both.
copy-on-select = clipboard

mouse-hide-while-typing = true
quit-after-last-window-closed = true
resize-overlay = never

# 8. With tabs disabled above, the default tab-cycling binds are dead keys and
# window cycling has no default bind at all. Remap the muscle memory.
keybind = super+shift+[=goto_window:previous
keybind = super+shift+]=goto_window:next

# 9. Don't prompt when closing
confirm-close-surface = false
# Ghostty also confirms multi-line pastes, which wezterm does not. Left on as
# a paste-injection guard; add `clipboard-paste-protection = false` to match.
