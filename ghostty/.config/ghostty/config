# Ghostty is the only terminal config in this repo. Kept intentionally explicit
# rather than using a bundled `theme = ...`, so the terminal palette can be
# generated the same way Omarchy's own theme engine does it.

# 1. Kanagawa (Omarchy's official "kanagawa" theme)
# The 15 accent colors are Omarchy's own themes/kanagawa/colors.toml, run through
# its default/themed/ghostty.conf.tpl mapping, verbatim. Mirrors nvim's
# lua/config/palette.lua (which is kanagawa.nvim's own Wave palette instead --
# Omarchy's neovim.lua just installs stock kanagawa.nvim, so editor and terminal
# accents are expected to diverge slightly; see the comments there).
#
# ONE deliberate deviation: the neutral base is Kanagawa **Dragon**'s grey ladder
# instead of Wave's purple-tinted sumiInk ladder, because a dark grey base was
# wanted. These are still official Kanagawa values (kanagawa.nvim's colors.lua
# `dragonBlack*`), not invented ones, so the base and the accents still come from
# the same designer's palette:
#   background / cursor-text / palette 0  sumiInk3 #1f1f28 -> dragonBlack2 #1D1C19
#   selection-background                  sumiInk5 #363646 -> dragonBlack5 #393836
# dragonBlack2 was picked over Dragon's own bg (dragonBlack3 #181616) because
# #181616 reads as near-black (L* 7.5) rather than grey. #1D1C19 is L* 10.3 --
# the same lightness as the old One Half Dark base this replaced -- and it raises
# foreground contrast from 11.26:1 to 11.74:1, which also helps the text read
# less thin. Keep `background`, `cursor-text` and `palette = 0` equal to each
# other, and equal to `bg` in nvim's palette.lua.
background = 1D1C19
foreground = dcd7ba

cursor-color = dcd7ba
cursor-text = 1D1C19

selection-background = 393836
selection-foreground = dcd7ba

palette = 0=#1D1C19
palette = 1=#c34043
palette = 2=#76946a
palette = 3=#c0a36e
palette = 4=#7e9cd8
palette = 5=#957fb8
palette = 6=#6a9589
palette = 7=#dcd7ba
palette = 8=#54546d
palette = 9=#e82424
palette = 10=#98bb6c
palette = 11=#e6c384
palette = 12=#7fb4ca
palette = 13=#938aa9
palette = 14=#7aa89f
palette = 15=#dcd7ba

# 2. Font
# The `Mono` variant specifically: its icon glyphs are forced to single cell
# width, which the plain and `Propo` Nerd Font builds do not do -- those make
# lualine and incline misalign. Only the `Mono` builds are installed anyway
# (`ghostty +list-fonts` lists JetBrainsMono Nerd Font Mono and
# JetBrainsMonoNL Nerd Font Mono -- NL = no ligatures -- and nothing else).
# Verified present in this face rather than assumed, by dumping its cmap:
# U+E62B and U+F031B (the devicon/material ranges mini.icons and blink draw
# from), plus U+25CF (incline's modified marker), U+EA87 and U+F00D.
# Powerline U+E0B0-B3 comes from Ghostty's internal sprites either way, so
# lualine's separators do not depend on the font at all.
# One codepoint is genuinely absent and it is fine: U+2726 (was starship's jobs
# symbol -- the current starship config has no jobs module, and the Menlo
# fallback below covers it regardless).
# The U+1FB00 legacy-computing block is NOT a font concern: Ghostty draws it from
# internal sprites too, so it renders whatever face is set. Do not re-add the old
# claim that it is missing here -- see smear-cursor.lua.
font-family = JetBrainsMono Nerd Font Mono
font-family = Menlo
font-size = 13

# Weight. JetBrains Mono Regular is NOT the thin one -- measured stem width of
# 'H' sampled above the crossbar, in 1/1000 em, so comparable across faces:
#   JetBrains Regular 90   Medium 99   SemiBold 108   Bold 125
#   IBM Plex  Regular 84   Text   97
# i.e. JetBrains Regular is already 7% heavier than IBM Plex Regular. The text
# read thin for a *contrast* reason, not a stroke reason: Kanagawa's warm beige
# fg on the old Wave background was 11.26:1 where the previous theme was 12.75:1.
# The grey base in section 1 recovers part of that; these two knobs do the rest.
#
# Medium (500) is a real drawn face, not synthesized, so it stays crisp -- unlike
# leaning on font-synthetic-style. Bold stays default (Bold, 125) so bold text is
# still clearly distinct from the 99 of Medium.
font-style = Medium
font-style-italic = Medium Italic
# macOS-only stem darkening, layered on top of the heavier face. This is the dial
# to back off first if the result looks too heavy or slightly blurred: either set
# font-thicken = false, or keep it and lower font-thicken-strength (0-255, default
# 255 -- and note 0 means "lightest thickening", not "none").
font-thicken = true
# This face exposes a `zero` GSUB feature that substitutes zero -> zero.zero
# (confirmed by dumping its GSUB table, not assumed -- JetBrains Mono's default
# zero is unslashed and the feature is what slashes it). Slashed zero
# disambiguates 0 from O in hashes, run IDs and cluster names.
font-feature = zero

# No adjust-cell-height: the face's natural line box is used as-is.
# Do NOT re-add the old "IBM Plex is wider than JetBrains Mono, so bump the size
# down" note that used to live here -- it was wrong. Both faces have an
# identical 600/1000 em advance (measured from hmtx/head), so 13pt gives a
# 7.80pt cell either way and the column count does not change between them.
# What does differ: JetBrains Mono has the larger x-height (0.550 em vs 0.516),
# so it reads slightly bigger at the same nominal size, and a marginally taller
# line box (1.32 em vs 1.30).
# Note the block cursor does NOT scale with this (see adjust-cursor-height).

# If text shows dark fringing against the transparent background,
# `alpha-blending = linear-corrected` is the knob to try -- it is
# weight-neutral, not a "lighter text" setting.

# 3. Transparency + blur
# This is what produces the translucent look: the wallpaper showing through the
# #1D1C19 background above. That background is a near-neutral warm grey (chroma
# 4/255), so it tints whatever is behind it rather than imposing a hue -- on a
# busy wallpaper the blur below is what keeps text legible, not the opacity.
# Ghostty has no gradient background option (the only related knobs are
# background-image and its -opacity/-position/-fit/-repeat); a gradient would
# mean generating a PNG for background-image, which is opaque and would defeat
# the blur below. Flat + blur was chosen over that.
# Changing background-opacity on macOS needs a full quit to take effect, and
# it is disabled in native fullscreen.
background-opacity = 0.85
# Ghostty's unit is an intensity (0-255), not a pixel radius.
background-blur = 30

# 4. Native tabs in the titlebar, window buttons hidden.
# Chosen over a fully hidden titlebar (`macos-titlebar-style = hidden`), which
# sets tabbingMode = .disallowed at the AppKit level: cmd+t would open a new
# window and macOS has no tab-overview fallback (window-show-tab-bar is
# GTK-only). The cost of `tabs` is a permanent title strip at the top even
# with a single tab.
# Default is `transparent`.
macos-titlebar-style = tabs
macos-window-buttons = hidden

# 5. Window padding. Ghostty's unit is points, so 10 here is 20px on a 2x
# display.
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true

# There is no tab-bar styling to set: macOS tabs are native chrome.

# 6. Steady block cursor.
# shell-integration's `cursor` feature is on by default and forces a bar at
# the zsh prompt, which would override this; no-cursor keeps the block. It
# also avoids the integration leaking a block cursor into fzf widgets.
# `block` is already the default, kept explicit because of the interaction above.
# Note this list toggles individual features rather than replacing the set:
# `ghostty +show-config` resolves it to
# no-cursor,no-sudo,title,ssh-env,no-ssh-terminfo,path -- only cursor and
# ssh-env differ from the defaults.
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor,ssh-env

# 7. Option key
# Ghostty resolves macos-option-as-alt to false on non-US layouts (this
# machine is Spanish - ISO), which breaks alt+b/alt+f in zsh and <M-...> in
# nvim. `left` means left Option = Alt while right Option still composes, so
# @ # [ ] { } remain typeable.
macos-option-as-alt = left

# Plain `true` prefers the selection clipboard, which on macOS is a private
# Ghostty pasteboard, so selections never reach the system clipboard.
# `clipboard` writes both.
copy-on-select = clipboard

mouse-hide-while-typing = true
quit-after-last-window-closed = true
resize-overlay = never

# 8. Window cycling. `goto_window` has no default bind at all
# (`+list-keybinds --default | grep goto_window` is empty). super+shift+[ and
# super+shift+] are NOT free -- they are the defaults for previous_tab/next_tab,
# so binding them here would silently shadow tab switching. ctrl+brackets are
# unbound in the defaults, and the tab binds (ctrl+tab / ctrl+shift+tab,
# super+shift+brackets, super+1..9) all stay live.
#
# `bracket_left`/`bracket_right`, NOT literal `[`/`]`: a single-codepoint trigger
# is matched against the *unmodified* codepoint of the key, which is layout
# dependent. This machine is com.apple.keylayout.Spanish-ISO, where no key produces
# a bare `[` or `]` (they need right-Option -- see the note in section 7), so the
# literal form never matched and goto_window had no working bind at all from when
# it was added until 2026-09-28. The W3C physical key names are layout independent.
# Same distinction as `backquote` vs `grave` in section 11.
keybind = super+ctrl+bracket_left=goto_window:previous
keybind = super+ctrl+bracket_right=goto_window:next

# 9. Don't prompt when closing
confirm-close-surface = false
# Multi-line paste confirmation is left on as a paste-injection guard; disable
# with `clipboard-paste-protection = false`.

# 10. Command-finish notifications (Ghostty 1.3.0+), for long dbt / azure-cli /
# databricks runs. `unfocused` means it only fires when the surface running the
# command is not focused, so foreground work stays silent. Requires OSC 133
# command marks, which shell-integration already provides (section 6).
# Deviations from the defaults: never -> unfocused, bell,no-notify ->
# no-bell,notify (a macOS notification instead of an audible bell), 5s -> 30s so
# ordinary commands don't generate noise.
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 30s

# 11. Quick terminal drop-down. toggle_quick_terminal has no default bind, and
# nothing in the defaults uses the backtick key. The key name is `backquote`
# (W3C code); `grave` is rejected with error.InvalidFormat in 1.3.1.
# `global:` means the key is captured system-wide rather than only when Ghostty
# is focused, which on macOS needs Accessibility permission (System Settings ->
# Privacy & Security -> Accessibility); Ghostty prompts for it on launch/reload
# and the bind silently does nothing until it is granted.
# No quick-terminal-* options here: the defaults (position top, autohide true,
# animation-duration 0.2) are already what's wanted.
keybind = global:super+backquote=toggle_quick_terminal

# 12. Scrollback. The unit is bytes and the limit is per terminal surface; the
# default 10000000 (10MB) truncates large query dumps. Scrollback is allocated
# lazily up to this limit, so the memory cost is only paid once it is actually
# filled.
scrollback-limit = 100000000

# 13. Per-machine overrides. The `?` prefix makes a missing file non-fatal, and
# the path is relative to this file, so this reads ./local next to the config if
# it exists. Loaded after everything above, so it wins. Intentionally not
# tracked, mirroring the .zshrc / .zshrc.example split in this repo.
config-file = ?local
