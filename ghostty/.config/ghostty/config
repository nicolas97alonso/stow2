# Ghostty is the only terminal config in this repo. Kept intentionally explicit
# rather than using a bundled `theme =`, because of the two deviations below.

# 1. "One Half Dark" palette (sonph/onehalf)
# Accents are upstream verbatim. The background was upstream's #282c34, darkened
# to #1a1c22 by request -- the navy cast comes from background-opacity + blur
# over a blue-toned wallpaper, NOT from a navy hex baked in here. Mirrored in
# nvim's lua/config/palette.lua; change both together.
background = 1a1c22
foreground = dcdfe4

cursor-color = dcdfe4
cursor-text = 282c34

# Upstream's terminal ports have no usable selection color (the kitty port ships
# #FFFACD), so this is the `selection` value from its vim colorscheme instead.
selection-background = 474e5d
selection-foreground = dcdfe4

# Deviation 1: upstream sets black AND brightBlack to #282c34, i.e. both equal
# the background, which makes anything printed in ANSI black or bright-black
# invisible. 0 is lifted to onehalf's own non_text; 8 to the value its kitty
# port uses. Everything else is upstream.
palette = 0=#373c45
palette = 1=#e06c75
palette = 2=#98c379
palette = 3=#e5c07b
palette = 4=#61afef
palette = 5=#c678dd
palette = 6=#56b6c2
palette = 7=#dcdfe4
# Deviation 2: upstream deliberately makes 9-15 identical to 1-7. Kept as
# upstream despite btop/htop leaning on brights being distinguishable -- the
# flat look is part of the theme's identity.
palette = 8=#5d677a
palette = 9=#e06c75
palette = 10=#98c379
palette = 11=#e5c07b
palette = 12=#61afef
palette = 13=#c678dd
palette = 14=#56b6c2
palette = 15=#dcdfe4

# 2. Font
# The Nerd Font patched build rather than plain JetBrains Mono: lualine's
# powerline separators, mini.icons and blink's kind icons need the glyphs.
# Ghostty matches on family name, and draws powerline/box-drawing from internal
# sprites, so no Symbols Nerd Font fallback is needed.
font-family = JetBrainsMono Nerd Font Mono
font-family = Menlo
font-size = 13
# The installed JetBrainsMono Nerd Font Mono face exposes a `zero` GSUB feature.
# Slashed zero disambiguates 0 from O in hashes, run IDs and cluster names.
font-feature = zero

# No adjust-cell-height: JetBrains Mono's natural 1.3200em line box is used
# as-is, matching upstream's config, which sets no adjustment either.
# Note the block cursor does NOT scale with this (see adjust-cursor-height).

# If text shows dark fringing against the transparent background,
# `alpha-blending = linear-corrected` is the knob to try -- it is
# weight-neutral, not a "lighter text" setting.

# 3. Transparency + blur
# This is what produces the "navy translucent" look: the wallpaper showing
# through a #282c34 background. A blue/teal wallpaper is part of the aesthetic
# -- on a neutral or warm wallpaper the theme just reads as flat grey.
# Changing background-opacity on macOS needs a full quit to take effect, and
# it is disabled in native fullscreen.
background-opacity = 0.95
# Ghostty's unit is an intensity (0-255), not a pixel radius.
background-blur = 20

# 4. Native tabs in the titlebar, window buttons hidden.
# Chosen over a fully hidden titlebar (`macos-titlebar-style = hidden`), which
# sets tabbingMode = .disallowed at the AppKit level: cmd+t would open a new
# window and macOS has no tab-overview fallback (window-show-tab-bar is
# GTK-only). The cost of `tabs` is a permanent title strip at the top even
# with a single tab.
# Default is `transparent`.
macos-titlebar-style = tabs
macos-window-buttons = hidden

# 5. Window padding. Ghostty's unit is points, so 10 here is 20px on a 2x
# display.
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true

# There is no tab-bar styling to set: macOS tabs are native chrome.

# 6. Steady block cursor.
# shell-integration's `cursor` feature is on by default and forces a bar at
# the zsh prompt, which would override this; no-cursor keeps the block. It
# also avoids the integration leaking a block cursor into fzf widgets.
# `block` is already the default, kept explicit because of the interaction above.
# Note this list toggles individual features rather than replacing the set:
# `ghostty +show-config` resolves it to
# no-cursor,no-sudo,title,ssh-env,no-ssh-terminfo,path -- only cursor and
# ssh-env differ from the defaults.
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor,ssh-env

# 7. Option key
# Ghostty resolves macos-option-as-alt to false on non-US layouts (this
# machine is Spanish - ISO), which breaks alt+b/alt+f in zsh and <M-...> in
# nvim. `left` means left Option = Alt while right Option still composes, so
# @ # [ ] { } remain typeable.
macos-option-as-alt = left

# Plain `true` prefers the selection clipboard, which on macOS is a private
# Ghostty pasteboard, so selections never reach the system clipboard.
# `clipboard` writes both.
copy-on-select = clipboard

mouse-hide-while-typing = true
quit-after-last-window-closed = true
resize-overlay = never

# 8. Window cycling. `goto_window` has no default bind at all
# (`+list-keybinds --default | grep goto_window` is empty). super+shift+[ and
# super+shift+] are NOT free -- they are the defaults for previous_tab/next_tab,
# so binding them here would silently shadow tab switching. ctrl+brackets are
# unbound in the defaults, and the tab binds (ctrl+tab / ctrl+shift+tab,
# super+shift+brackets, super+1..9) all stay live.
keybind = super+ctrl+[=goto_window:previous
keybind = super+ctrl+]=goto_window:next

# 9. Don't prompt when closing
confirm-close-surface = false
# Multi-line paste confirmation is left on as a paste-injection guard; disable
# with `clipboard-paste-protection = false`.

# 10. Command-finish notifications (Ghostty 1.3.0+), for long dbt / azure-cli /
# databricks runs. `unfocused` means it only fires when the surface running the
# command is not focused, so foreground work stays silent. Requires OSC 133
# command marks, which shell-integration already provides (section 6).
# Deviations from the defaults: never -> unfocused, bell,no-notify ->
# no-bell,notify (a macOS notification instead of an audible bell), 5s -> 30s so
# ordinary commands don't generate noise.
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 30s

# 11. Quick terminal drop-down. toggle_quick_terminal has no default bind, and
# nothing in the defaults uses the backtick key. The key name is `backquote`
# (W3C code); `grave` is rejected with error.InvalidFormat in 1.3.1.
# `global:` means the key is captured system-wide rather than only when Ghostty
# is focused, which on macOS needs Accessibility permission (System Settings ->
# Privacy & Security -> Accessibility); Ghostty prompts for it on launch/reload
# and the bind silently does nothing until it is granted.
# No quick-terminal-* options here: the defaults (position top, autohide true,
# animation-duration 0.2) are already what's wanted.
keybind = global:super+backquote=toggle_quick_terminal

# 12. Scrollback. The unit is bytes and the limit is per terminal surface; the
# default 10000000 (10MB) truncates large query dumps. Scrollback is allocated
# lazily up to this limit, so the memory cost is only paid once it is actually
# filled.
scrollback-limit = 100000000

# 13. Per-machine overrides. The `?` prefix makes a missing file non-fatal, and
# the path is relative to this file, so this reads ./local next to the config if
# it exists. Loaded after everything above, so it wins. Intentionally not
# tracked, mirroring the .zshrc / .zshrc.example split in this repo.
config-file = ?local
