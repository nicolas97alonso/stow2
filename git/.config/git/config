# Identity is deliberately NOT here: this repo is public. user.email lives in the
# untracked ~/.gitconfig, which git reads after this file, so it also wins any
# conflict with the values below. Side effect: once ~/.gitconfig exists,
# `git config --global` reads and writes only that file, so `--global --list`
# does not show this one. Use `git config --list --show-origin` instead.

[init]
	defaultBranch = main

[core]
	editor = nvim
	pager = delta

[pull]
	rebase = false

# nvimdiff is one of git's built-in tool backends (`git mergetool --tool-help`),
# so no [difftool]/[mergetool] cmd is needed.
[diff]
	tool = nvimdiff

[merge]
	tool = nvimdiff

# Without this, `git add -p` shows git's plain diff even though core.pager is delta.
[interactive]
	diffFilter = delta --color-only

# Syntax (`ansi`) and the decoration styles below use the terminal palette, so
# they re-color off Ghostty's like starship does. delta's own defaults for the
# +/- line backgrounds and the line-number grey stay fixed hex (`delta
# --show-config`); they are theme-neutral dark red/green.
[delta]
	line-numbers = true
	features = decorations
	syntax-theme = ansi

[delta "decorations"]
	commit-decoration-style = blue ol
	commit-style = raw
	file-style = omit
	hunk-header-decoration-style = blue box
	hunk-header-file-style = red
	hunk-header-line-number-style = green
	hunk-header-style = file line-number syntax

[alias]
	d = diff
	co = checkout
	ci = commit
	ca = commit -a
	ps = "!git push origin $(git rev-parse --abbrev-ref HEAD)"
	pl = "!git pull origin $(git rev-parse --abbrev-ref HEAD)"
	st = status
	br = branch
	ba = branch -a
	bm = branch --merged
	bn = branch --no-merged
	hist = log --pretty=format:\"%Cgreen%h %Creset%cd %Cblue[%cn] %Creset%s%C(yellow)%d%C(reset)\" --graph --date=relative --decorate --all
	llog = log --graph --name-status --pretty=format:\"%C(red)%h %C(reset)(%cd) %C(green)%an %Creset%s %C(yellow)%d%Creset\" --date=relative
	open = "!gh browse"
	type = cat-file -t
	dump = cat-file -p
	edit-unmerged = "!f() { git ls-files --unmerged | cut -f2 | sort -u ; }; nvim `f`"
	add-unmerged = "!f() { git ls-files --unmerged | cut -f2 | sort -u ; }; git add `f`"
