# Template. Copy to zsh/.zshenv and edit for this machine (see README).
#
# Runs for EVERY zsh — including non-interactive (`zsh -c`), git hooks, `make
# SHELL=zsh`, `ssh host cmd` and editor/agent tasks. That is the whole point of
# this file. Anything exported only from .zshrc is invisible outside an interactive
# shell, which is a silent failure: on this machine that meant
#
#   env -i /bin/zsh -c 'echo $PATH'   ->  /bin:/usr/bin:/usr/ucb:/usr/local/bin
#
# so hooks and subprocesses ran with no brew, no CA bundle and no libodbc, and
# `import pyodbc` failed only outside the terminal. Measured 2026-09-28.
#
# Keep this file to env vars only — no aliases, no functions, no prompt, nothing
# that writes to stdout. It runs for scripts too, and output here breaks scp/rsync.

: ${HOMEBREW_PREFIX:=$HOME/homebrew}

[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"

# -----------------------------
# PATH
# -----------------------------
# .zshrc deliberately repeats these two lines. Not redundant: macOS's /etc/zprofile
# runs path_helper for *login* shells, which reorders whatever this file set and
# pushes the system dirs back to the front — measured here, it demoted
# ~/.local/bin from position 2 to position 13, behind /usr/bin. Ghostty starts login
# shells, so .zshrc is what restores the intended precedence interactively, and this
# file is what gives non-interactive shells a PATH at all. typeset -U dedups.
export PATH="$HOMEBREW_PREFIX/bin:$HOME/.local/bin:$PATH"
export PATH="$PATH:/Applications/Visual Studio Code.app/Contents/Resources/app/bin"
typeset -U path PATH   # dedup PATH

# Install Homebrew casks (GUI apps) to ~/Applications — needed on a machine with no
# sudo, where brew can't write the default /Applications. Drop it if you have sudo.
export HOMEBREW_CASK_OPTS="--appdir=$HOME/Applications"

# -----------------------------
# Work-machine only — delete both blocks on a personal machine
# -----------------------------
# Node's bundle is missing the legacy GlobalSign Root CA needed for npmjs.org and
# the corporate roots needed for internal hosts and for pi's OAuth refresh
# (platform.claude.com). One persistent bundle, not a throwaway per-command pem.
# Has to be here rather than .zshrc: npm and pi are routinely started by things that
# are not an interactive shell, and those hit UNABLE_TO_GET_ISSUER_CERT_LOCALLY.
# Regeneration snippet lives in ~/.claude/CLAUDE.md.
export NODE_EXTRA_CA_CERTS="$HOME/.local/share/certs/allianz-ca-bundle.pem"

# SQL Server / ODBC. The whole ODBC stack hardcodes /opt/homebrew, so on any
# non-default-prefix install there are TWO breakages needing TWO variables; neither
# substitutes for the other:
#
# 1. pyodbc's .so *links* libodbc.2.dylib by absolute install name, so without the
#    FALLBACK line `import pyodbc` itself dies with
#    "Library not loaded: /opt/homebrew/opt/unixodbc/lib/libodbc.2.dylib".
# 2. libmsodbcsql.18.dylib *dlopens* OpenSSL by absolute path at connect time, trying
#    only /opt/homebrew/opt/openssl/lib and /opt/local/lib (MacPorts). Fixing (1)
#    alone just moves the failure one layer later, to "SSL Provider: [OpenSSL library
#    could not be loaded...]" — which dbt reports as the much less helpful
#    "08001 Client unable to establish connection".
#
# Why both, measured with DYLD_PRINT_LIBRARIES=1: FALLBACK is consulted only after a
# dylib misses its own install path and only for a bare leaf name, so it fixes (1)
# without being able to shadow a correctly linked library the way LIBRARY_PATH can —
# but it cannot fix (2), because dyld never consults FALLBACK for a dlopen whose
# argument contains a slash. LIBRARY_PATH *is* searched by leaf name even then, which
# is the only hook into a hardcoded absolute path. The trailing two FALLBACK entries
# are dyld's own documented defaults (`man dyld`); setting the variable at all
# replaces that list, so they are restored rather than silently dropped.
#
# Point LIBRARY_PATH at the openssl keg, NOT at $HOMEBREW_PREFIX/lib: the wide dir
# would shadow every brew library by leaf name, while the keg can only shadow
# libssl{,.3}.dylib and libcrypto{,.3}.dylib. Pin the versioned name so a future
# openssl@4 becoming the `openssl` alias cannot silently move it.
#
# The real fix is a /opt/homebrew/opt/{unixodbc,openssl} symlink, which needs sudo.
#
# Note SIP strips both DYLD_* vars across an exec of a restricted binary such as
# /bin/zsh, so neither can be inherited from a parent — they have to be assigned
# inside zsh, which is what this file does.
export DYLD_FALLBACK_LIBRARY_PATH="$HOMEBREW_PREFIX/lib:/usr/local/lib:/usr/lib"
export DYLD_LIBRARY_PATH="$HOMEBREW_PREFIX/opt/openssl@3/lib"
