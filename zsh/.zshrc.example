# Template. Copy to zsh/.zshrc and edit for this machine (see README).
# Machine-specific bits are parameterised through HOMEBREW_PREFIX rather than
# hardcoded, so the only things that normally need editing are the aliases.
: ${HOMEBREW_PREFIX:=$HOME/homebrew}

# -----------------------------
# 1. PATHS
# -----------------------------
# zsh/.zshenv is the authoritative copy of PATH -- .zshrc is read only for
# *interactive* shells, so anything set here alone is invisible to `zsh -c`, git
# hooks, make and editor tasks. Stow zsh/.zshenv as well as this file.
# This repeat is NOT redundant: macOS's /etc/zprofile runs path_helper for *login*
# shells, which reorders what .zshenv set and pushes the system dirs back to the
# front (it demoted ~/.local/bin from position 2 to 13). Terminals start login
# shells, so without this the intended precedence is lost. typeset -U dedups the
# overlap with .zshenv and ~/.zprofile.
export PATH="$HOMEBREW_PREFIX/bin:$HOME/.local/bin:$PATH"
export PATH="$PATH:/Applications/Visual Studio Code.app/Contents/Resources/app/bin"
typeset -U path PATH   # dedup PATH

# HOMEBREW_CASK_OPTS is set in .zshenv, not here -- nothing reorders plain env
# vars, so one copy is enough.

# -----------------------------
# 2. COMPLETIONS
# -----------------------------
# Wire Homebrew's completion definitions (_uv, _az, _gh, _sqlfluff, ...) then init.
fpath=("$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)
# Cache compinit: full rebuild at most once a day, otherwise fast load (-C skips the scan).
setopt EXTENDED_GLOB   # needed for the (#q...) glob qualifier below
autoload -Uz compinit
# Glob into an array -- a glob qualifier does NOT expand inside [[ ]], it stays
# literal there and the test is then always true. Match the dump only if older
# than 24h: match -> full rebuild, else fast load (-C).
_zdump=(~/.zcompdump(#qNmh+24))
if (( ${#_zdump} )); then
  compinit
  # compinit only *rewrites* the dump when completion definitions changed. Without
  # this touch the mtime never moves, the glob above keeps matching, and the
  # "once a day" cache degrades into a full compaudit on every single shell.
  touch ~/.zcompdump
else
  compinit -C
fi
unset _zdump
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'   # case-insensitive

# -----------------------------
# 3. HISTORY
# -----------------------------
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
# HIST_FCNTL_LOCK: SHARE_HISTORY across several terminal tabs means concurrent
# writes to one 50k-line file; fcntl locking is what stops them interleaving.
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS \
       HIST_IGNORE_SPACE HIST_REDUCE_BLANKS HIST_FCNTL_LOCK

# -----------------------------
# 4. SHELL OPTIONS
# -----------------------------
# EXTENDED_GLOB is already set in section 2 (the compinit glob needs it there).
# GLOB_DOTS makes * match dotfiles -- convenient, but it means `rm *` includes
# .git and .env. Drop it if that trade isn't wanted.
setopt AUTO_CD INTERACTIVE_COMMENTS GLOB_DOTS

# -----------------------------
# 5. ALIASES  (edit these per machine)
# -----------------------------
alias desktop="cd ~/Desktop"
alias repos="cd ~/code"
alias home="cd ~"
alias pyclean='find . -type d -name "__pycache__" -exec rm -rf {} +'
alias lg='lazygit'

# eza for ls. --group-directories-first is the only real behaviour change.
alias ls='eza --group-directories-first'
alias ll='eza -l --group-directories-first --git'
alias la='eza -la --group-directories-first --git'
alias lt='eza --tree --level=2 --group-directories-first'

# --paging=never keeps `cat` non-interactive so it still works in pipes.
alias cat='bat --paging=never'

# -----------------------------
# 6. ENV
# -----------------------------
export LS_COLORS="di=1;34:fi=0;37"

export MANPAGER="sh -c 'col -bx | bat -l man -p'"

# fd respects .gitignore and skips .git, so fzf stops walking .venv and
# node_modules.
export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'

# Secrets: read from the macOS Keychain, never written in this file. Add one with
#   security add-generic-password -a "$USER" -s my_service_token -w
# then export it here. Uncomment and rename per machine.
# export MY_SERVICE_TOKEN="$(security find-generic-password -a "$USER" -s my_service_token -w 2>/dev/null)"

# -----------------------------
# 7. TOOLS (zoxide / fzf / direnv)
# -----------------------------
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"
command -v fzf    >/dev/null && source <(fzf --zsh)
command -v direnv >/dev/null && eval "$(direnv hook zsh)"

# -----------------------------
# 8. PROMPT — Starship
# -----------------------------
command -v starship >/dev/null && eval "$(starship init zsh)"

# -----------------------------
# 9. ZSH PLUGINS (autosuggestions, then syntax-highlighting LAST)
# -----------------------------
source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
# zsh-syntax-highlighting MUST be the final sourced line — do not add anything below it.
source "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
