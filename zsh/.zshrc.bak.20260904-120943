# -----------------------------
# 1. PATHS
# -----------------------------
# Homebrew is also exported from ~/.zprofile, but that only runs for *login*
# shells. Repeating it here means a nested or non-login interactive zsh still
# finds brew -- without it the `command -v` guards in section 7 silently no-op
# and you get no prompt, no zoxide, no fzf, no nvim. typeset -U dedups the
# overlap.
export PATH="$HOME/homebrew/bin:$HOME/.local/bin:$PATH"
export PATH="$PATH:/Applications/Visual Studio Code.app/Contents/Resources/app/bin"
typeset -U path PATH   # dedup PATH

# Install Homebrew casks (GUI apps) to ~/Applications — no sudo on this laptop,
# so brew can't write the default /Applications.
export HOMEBREW_CASK_OPTS="--appdir=$HOME/Applications"

# -----------------------------
# 2. COMPLETIONS
# -----------------------------
# Wire Homebrew's completion definitions (_uv, _az, _gh, _sqlfluff, ...) then init.
fpath=("$HOME/homebrew/share/zsh/site-functions" $fpath)
# Cache compinit: full rebuild at most once a day, otherwise fast load (-C skips the scan).
setopt EXTENDED_GLOB   # needed for the (#q...) glob qualifier below
autoload -Uz compinit
# Glob into an array (it won't fire inside [[ ]], where it stays literal): match
# the dump only if older than 24h. Match -> full rebuild; else fast load (-C).
_zdump=(~/.zcompdump(#qNmh+24))
if (( ${#_zdump} )); then
  compinit
  # compinit only *rewrites* the dump when completion definitions changed. Without
  # this touch the mtime never moves, the glob above keeps matching, and the
  # "once a day" cache degrades into a full compaudit on every single shell.
  touch ~/.zcompdump
else
  compinit -C
fi
unset _zdump
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'   # case-insensitive

# -----------------------------
# 3. HISTORY
# -----------------------------
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
# HIST_FCNTL_LOCK: SHARE_HISTORY across several Ghostty tabs means concurrent
# writes to one 50k-line file; fcntl locking is what stops them interleaving.
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS \
       HIST_IGNORE_SPACE HIST_REDUCE_BLANKS HIST_FCNTL_LOCK

# -----------------------------
# 4. SHELL OPTIONS
# -----------------------------
# EXTENDED_GLOB is already set in section 2 (the compinit glob needs it there).
setopt AUTO_CD INTERACTIVE_COMMENTS GLOB_DOTS

# -----------------------------
# 5. ALIASES
# -----------------------------
alias desktop="cd ~/Desktop"
alias repos="cd ~/code"
alias ir="cd ~/code/all/are-strada-ir-dwh/"
alias home="cd ~"
alias fut="cd ~/code/projects/de-football/"
alias db="cd /Users/nicolas.alonso/code/projects/databricksdemo"

# ADF Monitor — installed as `adf` via `uv tool install --editable ~/code/projects/adf-monitor`
# `adf` = yesterday digest, `adf failures --investigate` = root-cause analysis
alias adf-digest='adf yesterday'
alias pyclean='find . -type d -name "__pycache__" -exec rm -rf {} +'

# eza for ls. --group-directories-first is the only real behaviour change; the
# rest is the same information ls gives, just aligned and coloured.
alias ls='eza --group-directories-first'
alias ll='eza -l --group-directories-first --git'
alias la='eza -la --group-directories-first --git'
alias lt='eza --tree --level=2 --group-directories-first'

# bat was installed and never wired up. --paging=never keeps `cat` non-interactive
# so it still works in pipes and command substitution.
alias cat='bat --paging=never'

# sqlnico — local Azure SQL query tool (Python + React, https://localhost:4123)
alias sqlnico='/Users/nicolas.alonso/code/projects/sqlnico/start.sh'
alias sqlnico-dev='/Users/nicolas.alonso/code/projects/sqlnico/dev.sh'  # hot-reload UI dev

alias dbeaver='/Users/nicolas.alonso/Applications/DBeaver.app/Contents/MacOS/dbeaver > /dev/null 2>&1 &'

nvimf() {
  local file
  file=$(fzf) && nvim "$file"
}

# -----------------------------
# 6. ENV
# -----------------------------
export LS_COLORS="di=1;34:fi=0;37"

# No DYLD_LIBRARY_PATH here on purpose. SIP strips it from every restricted
# binary, so it vanishes through /bin/sh, /usr/bin/env, make and
# subprocess(shell=True) -- it can never be relied on. It was presumably added
# for unixODBC, which does not need it: pyodbc links libodbc.2.dylib by absolute
# install name. If some tool ever does need it, scope it to that project's
# .envrc, not to every shell.

export MANPAGER="sh -c 'col -bx | bat -l man -p'"

# fd respects .gitignore and skips .git, so fzf stops walking .venv and
# node_modules. Also what the `nvimf` function below picks up.
export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'

# -----------------------------
# 7. TOOLS (zoxide / fzf / direnv)
# -----------------------------
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"
command -v fzf    >/dev/null && source <(fzf --zsh)
command -v direnv >/dev/null && eval "$(direnv hook zsh)"

# -----------------------------
# 8. PROMPT — Starship
# -----------------------------
command -v starship >/dev/null && eval "$(starship init zsh)"

# -----------------------------
# 9. ZSH PLUGINS (autosuggestions, then syntax-highlighting LAST)
# -----------------------------
source /Users/nicolas.alonso/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
# zsh-syntax-highlighting MUST be the final sourced line — do not add anything below it.
source /Users/nicolas.alonso/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
